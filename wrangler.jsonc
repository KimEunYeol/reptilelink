{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "reptilelink",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-27",
  "assets": { "directory": "./dist", "binding": "ASSETS", "not_found_handling": "single-page-application", "run_worker_first": ["/api/*", "/u/*", "/auth/*", "/onboarding", "/onboarding/*", "/dashboard", "/dashboard/*"] },
  "observability": { "enabled": false }
}
